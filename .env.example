# Copy to .env and fill in what you use. NOTE: the app does NOT auto-load .env —
# load it into your shell first (PowerShell:  Get-Content .env | ForEach-Object { if($_ -match '^([^#=]+)=(.*)$'){ Set-Item "env:$($Matches[1])" $Matches[2] } }
#                 Git Bash:    set -a; source .env; set +a )
# provider: anthropic
ANTHROPIC_API_KEY=
# provider: openai
OPENAI_API_KEY=
# provider: bedrock_converse (standard AWS credential chain; profile OR keys)
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# provider: claude_cli needs no variables (uses the local Claude Code login)
